"""
Waveform Generator Module.
Generates visualization images (PNG) from raw or mastered audio buffers.
"""

import numpy as np
from pathlib import Path
import wave
from utils import setup_logger

logger = setup_logger("WaveformGenerator")


class WaveformVisualizer:
    """Visualizes audio wave vectors into structural PNG representations without standard external plotting bloat."""

    @staticmethod
    def render_waveform_image(audio: np.ndarray, output_png_path: Path, width: int = 800, height: int = 200):
        """Generates a visual PNG waveform rendering."""
        try:
            import matplotlib
            matplotlib.use('Agg')
            import matplotlib.pyplot as plt

            logger.info(f"Rendering waveform image to {output_png_path}...")
            mono = np.mean(audio, axis=0) if audio.ndim > 1 else audio
            
            fig, ax = plt.subplots(figsize=(width / 100, height / 100), dpi=100)
            fig.patch.set_facecolor('#0f172a')
            ax.set_facecolor('#0f172a')
            
            # Plot waveform with cinematic glow aesthetic
            ax.plot(mono, color='#38bdf8', linewidth=0.5, alpha=0.8)
            ax.fill_between(range(len(mono)), mono, -mono, color='#0284c7', alpha=0.3)
            
            ax.axis('off')
            plt.subplots_adjust(top=1, bottom=0, right=1, left=0, hspace=0, wspace=0)
            plt.margins(0, 0)
            
            output_png_path.parent.mkdir(parents=True, exist_ok=True)
            plt.savefig(output_png_path, facecolor=fig.get_facecolor(), edgecolor='none', pad_inches=0)
            plt.close(fig)
            logger.info("Waveform rendered successfully.")
        except Exception as e:
            logger.warning(f"Matplotlib waveform render skipped: {e}. Generating placeholder visual record.")
            output_png_path.touch()
